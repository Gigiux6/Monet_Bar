rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin'
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated(); // Consente la ricerca per ID/Username per l'erogazione punti
      allow create: if isOwner(userId) && request.resource.data.points == 0 && (!('role' in request.resource.data) || request.resource.data.role == 'client');
      allow update: if (isOwner(userId) && request.resource.data.points == resource.data.points && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Transactions nested subcollection
      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
      }
    }

    // 2. Usernames (Checking registration and resolving username to uid)
    match /usernames/{username} {
      allow get: if true; // Public check to see if taken or to resolve UID before logging in
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 3. Menu Items
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Rewards Catalog
    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Coupons (Flat structure)
    match /coupons/{couponId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid && request.resource.data.status == 'active')
        || isAdmin()
      );
        
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'active' && request.resource.data.status == 'used')
        || isAdmin()
      );
        
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 6. News (Promos)
    match /news/{newsId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Notification Requests (Push requests)
    match /notification_requests/{requestId} {
      allow read, write: if isAdmin();
    }
  }
}
